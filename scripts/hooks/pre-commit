#!/bin/sh
# ============================================================
# Drobo Dashboard REBORN pre-commit hook — blocks personal/identifying data
# from ever being committed.
#
# Install it with:  sh scripts/install-hooks.sh
# That points git at scripts/hooks/, so this file updates with a pull.
#
# It scans the STAGED changes and refuses the commit if it finds:
#   - a database file (*.db / *.sqlite*)
#   - a real environment file (.env; .env.example/.sample/.template are fine)
#   - an absolute C:\Users\<name>\ path (leaks a Windows username)
#   - an email address that is not a demo, example or reserved-test address
#   - anything matching your private patterns in
#     scripts/pii_patterns.local (gitignored)
#
# Reviewed exceptions live in scripts/pii_allow.txt and are honoured
# here as well as by scripts/scan_for_pii.py and CI, so the same
# content is accepted at every gate. When they disagreed, the answer
# depended on which gate you happened to hit first.
#
# Deliberately GENERIC: it names no real person or username, so the
# hook itself carries no identifying data. Put machine-specific
# strings (your username, real name) in scripts/pii_patterns.local,
# which is gitignored and never leaves your machine.
# ============================================================
set -e

fail() {
    echo ""
    echo "  COMMIT BLOCKED by pre-commit hook (scripts/hooks/pre-commit)"
    echo "  Reason: $1"
    echo ""
    echo "  Fix the flagged content (or unstage the file) and commit again."
    echo "  If it is a reviewed exception, add a tight regex to"
    echo "  scripts/pii_allow.txt so CI accepts it too."
    echo "  Last resort: git commit --no-verify"
    echo ""
    exit 1
}

REPO_ROOT=$(git rev-parse --show-toplevel)
ALLOW_FILE="$REPO_ROOT/scripts/pii_allow.txt"

# Fold scripts/pii_allow.txt into one alternation. Blank lines and comments
# are dropped; if nothing is left the filter stays empty, because an empty
# grep pattern matches every line and would wave the whole check through.
# Carriage returns are stripped: a list saved on Windows would otherwise give
# every entry a trailing \r that never matches.
ALLOW_RE=""
if [ -f "$ALLOW_FILE" ]; then
    ALLOW_RE=$(tr -d '\r' < "$ALLOW_FILE" | grep -vE '^\s*(#|$)' | paste -sd '|' - || true)
fi

# Read candidate hits on stdin, print the ones no exception covers.
drop_allowed() {
    if [ -n "$ALLOW_RE" ]; then
        grep -viE "$ALLOW_RE" || true
    else
        cat
    fi
}

# 0. The commit AUTHOR email is published on every commit. Block real
# addresses; allow GitHub no-reply and demo/example placeholders.
author_email=$(git config user.email || true)
case "$author_email" in
    *@users.noreply.github.com|*@demo.com|*@example.com|*@example.org|*@example.net|*.example|"" ) : ;;
    * ) fail "commit author email '$author_email' is a real address. Set a private identity for this repo, e.g.:
      git config user.email \"YOURNAME@users.noreply.github.com\"" ;;
esac

staged_files=$(git diff --cached --name-only --diff-filter=ACM)

# 1. Block database files by name.
db_hit=$(printf '%s\n' "$staged_files" | grep -iE '\.(db|sqlite|sqlite3)$' || true)
[ -n "$db_hit" ] && fail "database file staged: $db_hit"

# 2. Block real .env files (allow the committed templates).
env_hit=$(printf '%s\n' "$staged_files" | grep -E '(^|/)\.env($|\.)' | grep -viE '\.env\.(example|sample|template)$' || true)
[ -n "$env_hit" ] && fail "environment file staged: $env_hit"

# 3. Content scan of the staged diff (added lines only).
# Exclude the hook, the scanner and the allowlist: all three carry detection
# rules or reviewed examples and would otherwise trip on their own text.
added=$(git diff --cached --diff-filter=ACM -U0 \
        -- . ':(exclude)scripts/hooks/pre-commit' ':(exclude)scripts/scan_for_pii.py' \
             ':(exclude)scripts/pii_allow.txt' \
        | grep '^+' | grep -v '^+++' || true)

# Absolute Windows user path — leaks a username, and won't work for others.
# The placeholder forms documentation is SUPPOSED to use are excluded, the same
# way scripts/scan_for_pii.py excludes them. Without this the hook blocked the
# very commit that added the exclusion to its sibling, because the explanation
# had to spell the placeholder out -- and a guard that fires on its own
# documentation gets bypassed with --no-verify, which is how it stops guarding.
# grep -E has no lookahead, so the steps are deliberate: find candidate paths,
# drop the placeholders, drop reviewed exceptions, and fail only on the rest.
# A candidate runs to the next separator, whitespace or quote -- the shape the
# scanner matches -- so a name that does not start with an ASCII letter is
# still caught. "All" is the first word of "C:\Users\All Users". The path is
# not echoed back: the account name in it is the thing being protected.
real_paths="$(printf '%s\n' "$added" | sed 's/^+//' \
    | grep -oiE 'C:[\\/]+Users[\\/]+[^\\/[:space:]"'"'"'`]*' \
    | grep -viE 'C:[\\/]+Users[\\/]+(<[^>]*>|you|your-?name|username|name|user|Public|All)$' \
    | grep -viE 'C:[\\/]+Users[\\/]+$' \
    | drop_allowed || true)"
[ -n "$real_paths" ] \
    && fail "absolute C:\\Users\\<name> path found in staged content (leaks a username)"

# 4. Any email that is not a placeholder or a reviewed exception.
# Strip the leading diff '+' first so decorators like @app.get / @router.post
# aren't misread as emails (the '+' would otherwise act as the local part).
# Reserved domains follow RFC 2606/6761 — .test and .invalid are as safe in a
# fixture as .example, and flagging them taught people to ignore the hook.
emails=$(printf '%s\n' "$added" | sed 's/^+//' | grep -oiE '[a-z0-9._%+-]+@[a-z0-9.-]+\.[a-z]{2,}' || true)
bad_email=$(printf '%s\n' "$emails" \
            | grep -viE '@(demo\.com|example\.(com|org|net)|[a-z0-9.-]+\.(example|test|invalid|localhost))$' \
            | drop_allowed || true)
[ -n "$bad_email" ] && fail "non-demo email address found in staged content: $bad_email"

# 5. Private patterns (gitignored — real name, username, share names).
#    Not "optional": this is the only step that can see a NAME, and on
#    2026-09-08 it was found silently skipped because the file did not exist,
#    while two real share names sat in tracked test fixtures. Absent is now
#    a warning on every commit rather than nothing at all.
#    Two more ways it could skip a name without a word are closed here: a
#    list saved with CRLF gave every pattern a trailing \r that matched
#    nothing, and `read` dropped a last line with no newline after it. And on
#    a match the pattern is not printed -- the pattern IS the name -- only its
#    line in the list.
#    Lines that credit drobo-utils and its author are left out of this step
#    only, exactly as scripts/scan_for_pii.py's CREDIT_CONTEXT does, because a
#    public credit can share a first name with someone on the private list.
#    Without that, the hook blocked any commit that added a credit line --
#    including a repository's first commit -- while the scanner and CI
#    passed the same lines. Keep the two regexes identical.
CREDIT_CONTEXT='drobo-utils|petersilva|Silva'
added_without_credits=$(printf '%s\n' "$added" | grep -viE "$CREDIT_CONTEXT" || true)
LOCAL="$REPO_ROOT/scripts/pii_patterns.local"
if [ ! -f "$LOCAL" ]; then
    echo "pre-commit: WARNING - scripts/pii_patterns.local is missing, so names"
    echo "            are NOT being checked. Create it (one regex per line)."
else
    n=0
    while IFS= read -r pat || [ -n "$pat" ]; do
        n=$((n + 1))
        pat=$(printf '%s' "$pat" | tr -d '\r')
        [ -z "$pat" ] && continue
        case "$pat" in \#*) continue ;; esac
        printf '%s\n' "$added_without_credits" | grep -qiE "$pat" \
            && fail "a private PII pattern matched (scripts/pii_patterns.local, line $n)"
    done < "$LOCAL"
fi

exit 0
