<Window x:Class="DroboDashboardReborn.DeleteShareDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Delete share"
        Width="440" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="#0D1116" Foreground="#E6EBF0"
        FontFamily="Segoe UI" FontSize="14"
        UseLayoutRounding="True">

    <Window.Resources>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#6B7683"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontFamily" Value="Consolas"/>
        </Style>
        <Style x:Key="Field" TargetType="Control">
            <Setter Property="Background" Value="#0D1116"/>
            <Setter Property="Foreground" Value="#E6EBF0"/>
            <Setter Property="BorderBrush" Value="#262E37"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Margin" Value="0,4,0,6"/>
        </Style>
    </Window.Resources>

    <StackPanel Margin="20">
        <TextBlock x:Name="Header" Text="Delete share" FontSize="17" FontWeight="SemiBold"/>
        <TextBlock x:Name="Sub" Style="{StaticResource Label}" Margin="0,2,0,12" TextWrapping="Wrap"/>

        <!-- Honest about the stakes, in the app's error colours: this is the
             one action in the app that destroys data on the Drobo. -->
        <TextBlock x:Name="WarningText" TextWrapping="Wrap" FontFamily="Consolas" FontSize="12"
                   Foreground="#E2564B" Background="#301714" Padding="10,8" Margin="0,0,0,16"/>

        <TextBlock Text="TYPE THE SHARE NAME TO CONFIRM" Style="{StaticResource Label}"/>
        <!-- Deliberately empty at first: the whole point is that the name has
             to be typed, not just clicked past. -->
        <TextBox x:Name="ConfirmBox" Style="{StaticResource Field}"
                 TextChanged="ConfirmBox_TextChanged"/>
        <TextBlock x:Name="ConfirmHint" Style="{StaticResource Label}" TextWrapping="Wrap"
                   Margin="0,0,0,16"/>

        <TextBlock x:Name="ErrorText" TextWrapping="Wrap" FontFamily="Consolas" FontSize="12"
                   Foreground="#E2564B" Background="#301714" Padding="10,8"
                   Visibility="Collapsed" Margin="0,0,0,16"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="CancelBtn" Content="Cancel" Padding="14,6" Margin="0,0,8,0"
                    Style="{StaticResource SecondaryButton}" FontSize="14"
                    Click="Cancel_Click" IsCancel="True"/>
            <!-- Not IsDefault on purpose: Enter after typing the name must not
                 double as the destructive click. Deleting takes a real click. -->
            <Button x:Name="DeleteBtn" Content="Delete share" Padding="14,6"
                    Style="{StaticResource DangerButton}" FontSize="14"
                    Click="Delete_Click" IsEnabled="False"/>
        </StackPanel>
    </StackPanel>
</Window>
