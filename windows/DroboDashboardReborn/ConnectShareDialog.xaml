<Window x:Class="DroboDashboardReborn.ConnectShareDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Connect to share"
        Width="420" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="#0D1116" Foreground="#E6EBF0"
        FontFamily="Segoe UI" FontSize="14"
        UseLayoutRounding="True">

    <Window.Resources>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#6B7683"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontFamily" Value="Consolas"/>
        </Style>
        <Style x:Key="Field" TargetType="Control">
            <Setter Property="Background" Value="#0D1116"/>
            <Setter Property="Foreground" Value="#E6EBF0"/>
            <Setter Property="BorderBrush" Value="#262E37"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Margin" Value="0,4,0,12"/>
        </Style>
    </Window.Resources>

    <StackPanel Margin="20">
        <TextBlock x:Name="Header" Text="Connect to share" FontSize="17" FontWeight="SemiBold"/>
        <TextBlock x:Name="SubtitleText" Style="{StaticResource Label}" Margin="0,2,0,16" TextWrapping="Wrap"/>

        <TextBlock Text="DROBO USERNAME" Style="{StaticResource Label}"/>
        <TextBox x:Name="UsernameBox" Style="{StaticResource Field}"/>

        <TextBlock Text="DROBO PASSWORD" Style="{StaticResource Label}"/>
        <PasswordBox x:Name="PasswordInput" Style="{StaticResource Field}"/>

        <!-- Mounting is OPTIONAL and says so. It used to be one entry buried
             in the drive-letter dropdown ("none, open without a drive
             letter"), which read as a strange letter choice rather than a real
             decision. Now it is an explicit checkbox; the letter list only
             lights up when you want a drive. Unchecked, the login still opens
             an SMB session, enough to browse the files; it just does not
             put a new drive in This PC. -->
        <CheckBox x:Name="MountCheck" Content="Also mount this share as a drive on this PC"
                  Foreground="#E6EBF0" Margin="0,0,0,6" IsChecked="False"
                  Checked="MountCheck_Changed" Unchecked="MountCheck_Changed"/>
        <Grid Margin="22,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="120"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="DRIVE LETTER" Style="{StaticResource Label}"
                       VerticalAlignment="Center" Margin="0,0,10,0"/>
            <ComboBox x:Name="DriveLetterBox" Grid.Column="1" Padding="8,6" IsEnabled="False"
                      Background="#0D1116" Foreground="#E6EBF0" BorderBrush="#262E37"/>
        </Grid>

        <!-- Always available since 2026-09-08. It used to be greyed out unless
             a drive letter was being mounted, because the only mechanism then
             was CONNECT_UPDATE_PROFILE, a flag Windows honours only for a
             connection that redirects a local device. The app now writes the
             credential itself through CredentialStore, which has no such
             limit, so the box means the same thing in both cases. -->
        <CheckBox x:Name="RememberCheck" Content="Save this login on this PC"
                  Foreground="#E6EBF0" Margin="0,0,0,4"/>
        <TextBlock x:Name="RememberNote" Style="{StaticResource Label}" TextWrapping="Wrap"
                   Foreground="#7BA7D0" Margin="0,0,0,4" Visibility="Collapsed"/>
        <TextBlock x:Name="ForgetLink" Style="{StaticResource Label}" Margin="0,0,0,4"
                   Foreground="#E9A83C" Cursor="Hand" Visibility="Collapsed"
                   Text="Forget the saved login for this Drobo"
                   TextDecorations="Underline"
                   MouseLeftButtonUp="Forget_Click"/>
        <TextBlock Style="{StaticResource Label}" TextWrapping="Wrap" Margin="0,0,0,16"
                   Text="Saves it in Windows Credential Manager, encrypted by Windows and readable only by your Windows account, so you are not asked again. You can see and remove it yourself in Control Panel, under Credential Manager. Left unticked, the login lasts only for this Windows sign-in session and nothing is written to this PC."/>

        <TextBlock x:Name="ErrorText" TextWrapping="Wrap" FontFamily="Consolas" FontSize="12"
                   Foreground="#E2564B" Background="#301714" Padding="10,8"
                   Visibility="Collapsed" Margin="0,0,0,16"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="CancelBtn" Content="Cancel" Padding="14,6" Margin="0,0,8,0"
                    Style="{StaticResource SecondaryButton}" FontSize="14"
                    Click="Cancel_Click" IsCancel="True"/>
            <Button x:Name="ConnectBtn" Content="Connect" Padding="14,6"
                    Style="{StaticResource PrimaryButton}" FontSize="14"
                    Click="Connect_Click" IsDefault="True"/>
        </StackPanel>
    </StackPanel>
</Window>
